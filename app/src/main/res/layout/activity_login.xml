<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_horizontal_padding"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingEnd="@dimen/screen_horizontal_padding"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Brand -->
        <TextView
            style="@style/AppText.Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/brand_name" />

        <!-- Title -->
        <TextView
            style="@style/AppText.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:text="@string/login_title" />

        <!-- Subtitle -->
        <TextView
            style="@style/AppText.Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/login_subtitle" />

        <!-- Email -->
        <EditText
            android:id="@+id/edtEmail"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="48dp"
            android:backgroundTint="@color/app_primary"
            android:hint="@string/email"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_hint" />

        <!-- Password -->
        <EditText
            android:id="@+id/edtPassword"
            style="@style/AppTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/app_primary"
            android:hint="@string/password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_hint" />

        <!-- Login -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/app_primary"
            android:text="@string/login"
            android:textAllCaps="false"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp" />

        <!-- Divider -->
        <TextView
            style="@style/AppText.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/or" />

        <!-- Google -->
        <Button
            android:id="@+id/btnGoogle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/app_surface"
            android:text="@string/continue_google"
            android:textAllCaps="false"
            android:textColor="@color/app_text_primary"
            android:textSize="14sp" />

        <!-- Register -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account"
                android:textColor="@color/app_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:padding="8dp"
                android:text="@string/create_account"
                android:textColor="@color/app_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
